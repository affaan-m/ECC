generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per Clerk-authenticated person. Subscription fields mirror Stripe
// so `isPro` can be derived without calling Stripe on every request.
model User {
  id                   String    @id @default(cuid())
  clerkId              String    @unique
  email                String    @unique

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active | trialing | past_due | canceled | incomplete | unpaid
  subscriptionPriceId  String?
  currentPeriodEnd     DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  data                 UserData?
}

// The whole app data blob (goals, events, contacts, notes, ...) as one JSON
// document per user — mirrors the same shape the frontend already keeps in
// localStorage, so syncing is "upload the object" / "download the object"
// rather than a normalized relational sync across nine entity types.
model UserData {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
