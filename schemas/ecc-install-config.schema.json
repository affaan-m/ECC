{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECC Install Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "target": {
      "type": "string",
      "enum": [
        "claude",
        "claude-project",
        "cursor",
        "antigravity",
        "codex",
        "gemini",
        "opencode",
        "codebuddy",
        "joycode",
        "qwen",
        "zed",
        "hermes",
        "openclaw",
        "kimi"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(baseline|lang|framework|capability):[a-z0-9-]+$"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(baseline|lang|framework|capability):[a-z0-9-]+$"
      }
    },
    "hookAuthorizations": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "automatic-source-writes",
          "command-rewrite-and-process-control",
          "transcript-derived-llm-egress",
          "mcp-network-and-process-activity",
          "automatic-permission-gates",
          "session-observation-and-cost-records"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "allow",
          "decline"
        ]
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
