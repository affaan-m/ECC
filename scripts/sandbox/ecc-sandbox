#!/usr/bin/env node
'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const {
  loadManifest,
  readBoundedRegularFile,
  validateCapabilities,
  validateReport,
} = require('./contracts');
const {
  defaultHost,
  normalizeArch,
  normalizeOs,
  resolveRuntimeEscalation,
  resolveTierOneFallback,
  routeManifest,
} = require('./router');
const {
  probeCapabilities,
  readCapabilityCache,
  writeCapabilityCache,
} = require('./probe');
const { executeSrt } = require('./backends/srt');
const { executeContainer } = require('./backends/podman');
const { executeMicrosandbox } = require('./backends/microsandbox');
const { executeLume } = require('./backends/lume');
const { executeLima } = require('./backends/lima');
const { executeTart } = require('./backends/tart');
const { executeCiNative } = require('./backends/ci-native');
const { executeCi } = require('./backends/ci');
const { loadMockScenario, mockRunner } = require('./mock');
const { buildAggregateReport, tailOutput } = require('./report');

const COMMANDS = ['probe', 'run', 'report', 'escalate'];

function writeJson(value) {
  process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
}

function help() {
  return {
    name: 'ecc-sandbox',
    usage: [
      'ecc-sandbox probe [--refresh] [--cache <file>] [--mock <capabilities.json>]',
      'ecc-sandbox run <sandbox.yaml> [--dry-run] [--local-only] [--shard <os/arch>] [--capabilities <file>] [--mock <file>]',
      'ecc-sandbox report <report.json>',
      'ecc-sandbox escalate <report.json> [--capabilities <file>] [--mock <file>]',
    ],
    commands: COMMANDS,
  };
}

function parseRunArgs(args) {
  const options = {
    manifestPath: null,
    dryRun: false,
    localOnly: false,
    capabilitiesPath: null,
    mockPath: null,
    shard: null,
  };

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '--dry-run') {
      options.dryRun = true;
    } else if (arg === '--local-only') {
      options.localOnly = true;
    } else if (arg === '--capabilities' || arg === '--mock' || arg === '--shard') {
      const value = args[index + 1];
      if (!value || value.startsWith('-')) {
        throw new Error(`${arg} requires a value`);
      }
      if (arg === '--shard') {
        const match = value.match(/^(linux|macos|windows)\/(arm64|x86_64)$/);
        if (!match) throw new Error('--shard must be linux|macos|windows/arm64|x86_64');
        options.shard = { os: normalizeOs(match[1]), arch: normalizeArch(match[2]) };
      } else {
        options[arg === '--capabilities' ? 'capabilitiesPath' : 'mockPath'] = value;
      }
      index += 1;
    } else if (arg.startsWith('-')) {
      throw new Error(`Unknown run argument: ${arg}`);
    } else if (options.manifestPath === null) {
      options.manifestPath = arg;
    } else {
      throw new Error(`Unexpected run argument: ${arg}`);
    }
  }

  if (!options.manifestPath) {
    throw new Error('run requires a sandbox manifest path');
  }
  if (options.dryRun && options.mockPath) {
    throw new Error('--mock executes an adapter and cannot be combined with --dry-run');
  }
  return options;
}

function parseProbeArgs(args) {
  const options = { refresh: false, cachePath: null, mockPath: null };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '--refresh') {
      options.refresh = true;
    } else if (arg === '--cache' || arg === '--mock') {
      const value = args[index + 1];
      if (!value || value.startsWith('-')) {
        throw new Error(`${arg} requires a file path`);
      }
      options[arg === '--cache' ? 'cachePath' : 'mockPath'] = value;
      index += 1;
    } else {
      throw new Error(`Unknown probe argument: ${arg}`);
    }
  }
  return options;
}

function parseEscalateArgs(args) {
  const options = { reportPath: null, capabilitiesPath: null, mockPath: null };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '--capabilities' || arg === '--mock') {
      const value = args[index + 1];
      if (!value || value.startsWith('-')) {
        throw new Error(`${arg} requires a JSON file path`);
      }
      options[arg === '--capabilities' ? 'capabilitiesPath' : 'mockPath'] = value;
      index += 1;
    } else if (arg.startsWith('-')) {
      throw new Error(`Unknown escalate argument: ${arg}`);
    } else if (options.reportPath === null) {
      options.reportPath = arg;
    } else {
      throw new Error(`Unexpected escalate argument: ${arg}`);
    }
  }
  if (!options.reportPath) throw new Error('escalate requires a sandbox report path');
  return options;
}

function emptyCapabilityMap() {
  return {
    schema_version: 1,
    host: defaultHost(),
    backends: Object.fromEntries([
      'srt',
      'podman',
      'docker',
      'microsandbox',
      'lume',
      'lima',
      'windows-sandbox',
      'hyper-v',
      'dockur-windows',
      'tart',
      'ci-native',
      'ci',
    ].map(backend => [backend, { available: false }])),
  };
}

function defaultCapabilityCachePath() {
  const cacheRoot = process.env.XDG_CACHE_HOME || path.join(os.homedir(), '.cache');
  return path.join(cacheRoot, 'ecc', 'sandbox-capabilities.json');
}

function loadCapabilities(filePath) {
  const candidate = filePath ? path.resolve(filePath) : defaultCapabilityCachePath();
  if (!fs.existsSync(candidate)) return emptyCapabilityMap();
  const capabilities = validateCapabilities(JSON.parse(
    readBoundedRegularFile(candidate, 'Capability map')
  ));
  const host = defaultHost();
  if (capabilities.host.os !== host.os || capabilities.host.arch !== host.arch) {
    throw new Error(
      `Capability map host ${capabilities.host.os}/${capabilities.host.arch} does not match current host ${host.os}/${host.arch}; run ecc-sandbox probe --refresh`
    );
  }
  return capabilities;
}

function resolveRun(options) {
  const manifestPath = path.resolve(options.manifestPath);
  const manifest = loadManifest(manifestPath);
  const capabilities = loadCapabilities(options.capabilitiesPath);
  const decision = routeManifest(manifest, capabilities, {
    localOnly: options.localOnly,
    manifestPath,
    shard: options.shard,
  });
  return { capabilities, decision, manifest, manifestPath };
}

function runDryRun(options) {
  return resolveRun(options).decision;
}

function executeRoute(resolved, route, executionOptions) {
  if (![
    'srt', 'podman', 'docker', 'microsandbox', 'lume', 'lima', 'tart', 'ci-native',
  ].includes(route.backend)) {
    throw new Error(`${route.backend} execution is unavailable until its adapter phase`);
  }
  const adapterOptions = {
    ...executionOptions,
    arch: route.arch,
    cwd: process.cwd(),
    manifestPath: resolved.manifestPath,
    notes: route.notes,
  };
  if (route.backend === 'srt') {
    return executeSrt(resolved.manifest, {
      ...adapterOptions,
      enableWeakerNestedSandbox: process.env.ECC_SANDBOX_ALLOW_NESTED_SRT === '1',
      os: route.os,
      platform: process.platform,
    });
  }
  if (route.backend === 'microsandbox') {
    const microsandbox = executeMicrosandbox(resolved.manifest, {
      ...adapterOptions,
      image: process.env.ECC_SANDBOX_IMAGE,
      snapshot: process.env.ECC_SANDBOX_MICROSANDBOX_SNAPSHOT,
    });
    if (!microsandbox.startupFailure) return microsandbox;
    if (!microsandbox.cleanup.safe_for_fallback) return microsandbox;

    const fallbackRoute = resolveTierOneFallback(
      resolved.manifest,
      resolved.capabilities,
      { os: route.os, arch: route.arch },
      { exclude: ['microsandbox'] }
    );
    if (fallbackRoute.result !== 'routable') return microsandbox;
    const fallback = executeRoute(resolved, fallbackRoute, executionOptions);
    fallback.report = validateReport({
      ...fallback.report,
      notes: [
        ...fallback.report.notes,
        `Microsandbox startup failed; fell back within Tier 1: ${tailOutput(microsandbox.report.notes.join('; '), 20, 3_000)}`,
      ],
    });
    return fallback;
  }
  if (route.backend === 'ci-native') {
    const platform = { linux: 'linux', macos: 'darwin', windows: 'win32' }[route.os];
    return executeCiNative(resolved.manifest, {
      ...adapterOptions,
      env: process.env,
      os: route.os,
      platform,
    });
  }
  if (route.backend === 'lume') {
    return executeLume(resolved.manifest, {
      ...adapterOptions,
      seed: process.env.ECC_SANDBOX_LUME_SEED,
    });
  }
  if (route.backend === 'lima') {
    return executeLima(resolved.manifest, {
      ...adapterOptions,
      seed: process.env.ECC_SANDBOX_LIMA_SEED,
    });
  }
  if (route.backend === 'tart') {
    return executeTart(resolved.manifest, {
      ...adapterOptions,
      seed: process.env.ECC_SANDBOX_TART_SEED,
    });
  }
  return executeContainer(resolved.manifest, {
    ...adapterOptions,
    image: process.env.ECC_SANDBOX_IMAGE,
    runtime: route.backend,
  });
}

function addEscalation(initial, destination) {
  const failedStep = initial.report.steps.find(step => step.exit !== 0);
  const initialEvidence = failedStep
    ? tailOutput(failedStep.stderr_tail || failedStep.stdout_tail, 10, 2_000)
    : 'policy denial detected without bounded step output';
  destination.report = validateReport({
    ...destination.report,
    started: initial.report.started,
    duration_ms: initial.report.duration_ms + destination.report.duration_ms,
    escalations: [{
      from: 'srt',
      reason: 'installer or system-write policy denial',
      to: destination.report.backend,
    }],
    notes: [
      ...destination.report.notes,
      `Initial SRT attempt denied before one-hop escalation: ${initialEvidence}`,
    ],
  });
  return destination;
}

function executeWithEscalation(resolved, route, executionOptions) {
  const initial = executeRoute(resolved, route, executionOptions);
  if (route.backend !== 'srt' || !initial.denial?.installer) return initial;

  const escalationRoute = resolveRuntimeEscalation(
    resolved.manifest,
    resolved.capabilities,
    route
  );
  if (escalationRoute.result !== 'routable') {
    initial.report = validateReport({
      ...initial.report,
      notes: [
        ...initial.report.notes,
        `Automatic escalation unavailable: ${escalationRoute.reason}. ${escalationRoute.fix}`,
      ],
    });
    return initial;
  }
  return addEscalation(
    initial,
    executeRoute(resolved, escalationRoute, executionOptions)
  );
}

function runExecution(options) {
  const resolved = resolveRun(options);
  if (resolved.decision.result !== 'routable') {
    const failed = resolved.decision.routes.find(route => route.result === 'error');
    throw new Error(`${failed.reason}. ${failed.fix}`);
  }
  let run;
  let mock = false;
  if (options.mockPath) {
    run = mockRunner(loadMockScenario(path.resolve(options.mockPath), 'sandbox'));
    mock = true;
  }
  const executionOptions = { mock, run };
  const ciRoutes = resolved.decision.routes.filter(route => route.backend === 'ci');
  const localRoutes = resolved.decision.routes.filter(route => route.backend !== 'ci');
  if (ciRoutes.length === 0 && localRoutes.length === 1) {
    return executeWithEscalation(resolved, localRoutes[0], executionOptions);
  }

  const orchestrationStartedMs = Date.now();
  const started = new Date(orchestrationStartedMs).toISOString();
  const children = localRoutes.map(route => (
    executeWithEscalation(resolved, route, executionOptions).report
  ));
  const aggregateNotes = [];
  if (ciRoutes.length > 0) {
    const ci = executeCi(resolved.manifest, ciRoutes, {
      ...executionOptions,
      artifactDirectory: process.env.ECC_SANDBOX_CI_ARTIFACT_DIR,
      cwd: process.cwd(),
      gitRoot: process.env.ECC_SANDBOX_CI_GIT_ROOT,
      manifestPath: resolved.manifestPath,
      ref: process.env.ECC_SANDBOX_CI_REF,
      repository: process.env.ECC_SANDBOX_CI_REPO,
    });
    children.push(...ci.report.children);
    aggregateNotes.push(...ci.report.notes);
  }
  const venue = ciRoutes.length === 0 ? 'local' : (localRoutes.length === 0 ? 'ci' : 'mixed');
  const report = buildAggregateReport({
    manifest: resolved.manifestPath,
    venue,
    started,
    durationMs: Date.now() - orchestrationStartedMs,
    children,
    notes: aggregateNotes,
  });
  return {
    report,
    exitCode: report.result === 'pass' ? 0 : (report.result === 'fail' ? 1 : 2),
  };
}

function runProbe(options) {
  const cachePath = path.resolve(options.cachePath || defaultCapabilityCachePath());
  if (options.mockPath) {
    const mocked = readCapabilityCache(path.resolve(options.mockPath));
    if (options.cachePath) writeCapabilityCache(cachePath, mocked);
    return mocked;
  }
  if (!options.refresh && fs.existsSync(cachePath)) {
    const cached = readCapabilityCache(cachePath);
    const host = defaultHost();
    if (cached.host.os !== host.os || cached.host.arch !== host.arch) {
      throw new Error(
        `Capability cache is for ${cached.host.os}/${cached.host.arch}; refresh it with ecc-sandbox probe --refresh`
      );
    }
    return cached;
  }
  const capabilities = probeCapabilities();
  writeCapabilityCache(cachePath, capabilities);
  return capabilities;
}

function runReport(args) {
  if (args.length !== 1) {
    throw new Error('report requires exactly one report JSON path');
  }
  const reportPath = path.resolve(args[0]);
  const report = JSON.parse(readBoundedRegularFile(reportPath, 'Sandbox report'));
  validateReport(report);
  return {
    result: 'valid',
    report: reportPath,
    report_result: report.result,
  };
}

function runEscalation(options) {
  const reportPath = path.resolve(options.reportPath);
  const sourceReport = validateReport(JSON.parse(
    readBoundedRegularFile(reportPath, 'Sandbox report')
  ));
  if (sourceReport.backend !== 'srt' || sourceReport.tier !== 0) {
    throw new Error('escalate accepts only a Tier 0 SRT report');
  }
  if (sourceReport.escalations.length !== 0) {
    throw new Error('this report already contains its one permitted escalation');
  }
  if (
    sourceReport.result === 'pass'
    || !sourceReport.notes.some(note => (
      note.includes('installer or system-write command is eligible for one-hop escalation')
    ))
  ) {
    throw new Error('the SRT report does not record an eligible installer or system-write denial');
  }

  const manifestPath = path.isAbsolute(sourceReport.manifest)
    ? sourceReport.manifest
    : path.resolve(path.dirname(reportPath), sourceReport.manifest);
  const resolved = {
    capabilities: loadCapabilities(options.capabilitiesPath),
    manifest: loadManifest(manifestPath),
    manifestPath,
  };
  const route = resolveRuntimeEscalation(
    resolved.manifest,
    resolved.capabilities,
    { backend: 'srt', os: sourceReport.os, arch: sourceReport.arch }
  );
  if (route.result !== 'routable') {
    throw new Error(`${route.reason}. ${route.fix}`);
  }
  let run;
  let mock = false;
  if (options.mockPath) {
    run = mockRunner(loadMockScenario(path.resolve(options.mockPath), route.backend));
    mock = true;
  }
  // DECISION: CONVENTIONS item 24 makes manual escalation consume the prior
  // denial report and execute only the one destination attempt.
  return addEscalation(
    { report: sourceReport },
    executeRoute(resolved, route, { mock, run })
  );
}

function main(argv = process.argv.slice(2)) {
  const [command, ...args] = argv;
  if (!command || command === '--help' || command === '-h' || command === 'help') {
    writeJson(help());
    return 0;
  }
  if (!COMMANDS.includes(command)) {
    throw new Error(`Unknown command: ${command}`);
  }
  if (command === 'run') {
    const options = parseRunArgs(args);
    if (options.dryRun) {
      const decision = runDryRun(options);
      writeJson(decision);
      return decision.result === 'routable' ? 0 : 2;
    }
    const outcome = runExecution(options);
    writeJson(outcome.report);
    return outcome.exitCode;
  }
  if (command === 'probe') {
    writeJson(runProbe(parseProbeArgs(args)));
    return 0;
  }
  if (command === 'report') {
    writeJson(runReport(args));
    return 0;
  }
  const outcome = runEscalation(parseEscalateArgs(args));
  writeJson(outcome.report);
  return outcome.exitCode;
}

if (require.main === module) {
  try {
    process.exitCode = main();
  } catch (error) {
    writeJson({
      result: 'error',
      error: {
        code: error.name === 'ContractValidationError' ? 'contract-invalid' : 'sandbox-cli-error',
        message: error.message,
        details: error.errors || [],
      },
    });
    process.exitCode = 2;
  }
}

module.exports = {
  defaultCapabilityCachePath,
  emptyCapabilityMap,
  help,
  loadCapabilities,
  main,
  parseEscalateArgs,
  parseRunArgs,
  parseProbeArgs,
  resolveRun,
  runExecution,
  runProbe,
  runDryRun,
  runEscalation,
  runReport,
  executeRoute,
  executeWithEscalation,
  addEscalation,
  writeJson,
};
