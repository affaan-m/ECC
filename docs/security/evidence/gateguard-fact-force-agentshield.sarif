{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentShield",
          "informationUri": "https://github.com/affaan-m/agentshield",
          "rules": [
            {
              "id": "hooks-no-pretooluse",
              "name": "No PreToolUse security hooks configured",
              "shortDescription": {
                "text": "No PreToolUse security hooks configured"
              },
              "fullDescription": {
                "text": "No PreToolUse hooks are defined. These hooks can catch dangerous operations before they run, providing an essential security layer."
              },
              "help": {
                "text": "No PreToolUse hooks are defined. These hooks can catch dangerous operations before they run, providing an essential security layer.\n\nRecommended fix: Add PreToolUse hooks for security-sensitive operations"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "misconfiguration",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "misconfiguration"
                ],
                "precision": "high"
              }
            },
            {
              "id": "hooks-chained-commands-0",
              "name": "Hook has 31 chained commands",
              "shortDescription": {
                "text": "Hook has 31 chained commands"
              },
              "fullDescription": {
                "text": "A hook chains 31 commands together: \"node -e \"if(!process.env.PLUGIN_ROOT)throw new Error('Missing Codex PLUGIN_ROOT'...\". Complex chained commands in hooks are harder to audit and may perform operations beyond the hook's stated purpose. Consider breaking into a dedicated script file."
              },
              "help": {
                "text": "A hook chains 31 commands together: \"node -e \"if(!process.env.PLUGIN_ROOT)throw new Error('Missing Codex PLUGIN_ROOT'...\". Complex chained commands in hooks are harder to audit and may perform operations beyond the hook's stated purpose. Consider breaking into a dedicated script file.\n\nRecommended fix: Move complex logic to a script file"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "hooks",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "hooks"
                ],
                "precision": "high"
              }
            },
            {
              "id": "hooks-inline-eval-payload",
              "name": "SessionStart hook runs a 1177-character inline payload",
              "shortDescription": {
                "text": "SessionStart hook runs a 1177-character inline payload"
              },
              "fullDescription": {
                "text": "The hook command feeds a long inline payload to an interpreter or decoder instead of running a script file. Inline payloads are hard to review, are not anchored to a plugin or project directory, and are the usual way to hide a dropper in a hook."
              },
              "help": {
                "text": "The hook command feeds a long inline payload to an interpreter or decoder instead of running a script file. Inline payloads are hard to review, are not anchored to a plugin or project directory, and are the usual way to hide a dropper in a hook."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "hooks",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "hooks"
                ],
                "precision": "high"
              }
            },
            {
              "id": "permissions-no-block",
              "name": "No permissions block configured",
              "shortDescription": {
                "text": "No permissions block configured"
              },
              "fullDescription": {
                "text": "settings.json has configuration but no permissions section. Without explicit allow/deny lists, the agent relies on default permissions which may be too broad. Add a permissions block to restrict tool access."
              },
              "help": {
                "text": "settings.json has configuration but no permissions section. Without explicit allow/deny lists, the agent relies on default permissions which may be too broad. Add a permissions block to restrict tool access.\n\nRecommended fix: Add a permissions block with scoped allow and deny lists"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "permissions",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "permissions"
                ],
                "precision": "high"
              }
            },
            {
              "id": "hooks-no-stop-hooks",
              "name": "No Stop hooks for session-end verification",
              "shortDescription": {
                "text": "No Stop hooks for session-end verification"
              },
              "fullDescription": {
                "text": "Hooks are configured but no Stop hooks exist. Stop hooks run when a session ends and are useful for final verification — checking for uncommitted secrets, ensuring console.log statements were removed, or auditing file changes."
              },
              "help": {
                "text": "Hooks are configured but no Stop hooks exist. Stop hooks run when a session ends and are useful for final verification — checking for uncommitted secrets, ensuring console.log statements were removed, or auditing file changes.\n\nRecommended fix: Add a Stop hook for session-end checks"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "misconfiguration",
                "severity": "low",
                "security-severity": "2.5",
                "tags": [
                  "security",
                  "agent-config",
                  "misconfiguration"
                ],
                "precision": "high"
              }
            },
            {
              "id": "hooks-code-transcript-access-1418",
              "name": "Hook code reads Claude transcript input",
              "shortDescription": {
                "text": "Hook code reads Claude transcript input"
              },
              "fullDescription": {
                "text": "This non-shell hook implementation reads transcript-derived input (`transcript_path` or `CLAUDE_TRANSCRIPT_PATH`). That is common for Stop and SessionEnd hooks, but it should be reviewed because downstream logic can process sensitive prompt and tool history."
              },
              "help": {
                "text": "This non-shell hook implementation reads transcript-derived input (`transcript_path` or `CLAUDE_TRANSCRIPT_PATH`). That is common for Stop and SessionEnd hooks, but it should be reviewed because downstream logic can process sensitive prompt and tool history."
