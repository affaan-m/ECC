            {
              "id": "mcp-url-transport-vercel",
              "name": "Template MCP server \"vercel\" connects to external URL",
              "shortDescription": {
                "text": "Template MCP server \"vercel\" connects to external URL"
              },
              "fullDescription": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. The MCP server \"vercel\" uses URL transport connecting to \"https://mcp.vercel.com\". External MCP connections send all tool calls and results over the network, potentially exposing code, secrets, and session data to a remote server. Prefer local stdio-based MCP servers."
              },
              "help": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. The MCP server \"vercel\" uses URL transport connecting to \"https://mcp.vercel.com\". External MCP connections send all tool calls and results over the network, potentially exposing code, secrets, and session data to a remote server. Prefer local stdio-based MCP servers.\n\nRecommended fix: Use a local stdio-based MCP server instead"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "mcp",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "mcp"
                ],
                "precision": "medium"
              }
            },
