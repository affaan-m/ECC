PORT=3000

# Your upstream API keys — TokenGuard forwards these transparently
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Optimization settings
TOKENGUARD_AGGRESSIVE=false   # true = enable filler-phrase removal
TOKENGUARD_CACHE_TTL_MS=1800000  # 30 min default

# Org
TOKENGUARD_ORG_ID=my-company
