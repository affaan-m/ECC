{
  "baseManifest": {
    "name": "routing-fixture",
    "needs": {
      "os": ["macos"],
      "arch": ["arm64"],
      "capabilities": [],
      "trust": "first-party",
      "native": false
    },
    "resources": {
      "cpu": 2,
      "memory": "2GB",
      "timeout": 300
    },
    "steps": {
      "setup": ["node --version"],
      "assert": ["node --version"]
    },
    "report": "exit-only"
  },
  "cases": [
    {
      "name": "benign host process uses SRT",
      "backends": { "srt": { "available": true } },
      "expected": ["srt"]
    },
    {
      "name": "workspace write remains Tier 0",
      "needs": { "capabilities": ["fs-write"] },
      "backends": { "srt": { "available": true } },
      "expected": ["srt"]
    },
    {
      "name": "clean home routes to Podman",
      "needs": { "os": ["linux"], "capabilities": ["clean-home"] },
      "backends": { "podman": { "available": true } },
      "expected": ["podman"]
    },
    {
      "name": "package installation routes to Podman",
      "needs": { "os": ["linux"], "capabilities": ["pkg-install"] },
      "backends": { "podman": { "available": true } },
      "expected": ["podman"]
    },
    {
      "name": "untrusted Linux uses Podman with an explicit boundary note",
      "needs": { "os": ["linux"], "trust": "untrusted" },
      "backends": { "podman": { "available": true } },
      "expected": ["podman"],
      "notePattern": "not a VM security boundary"
    },
    {
      "name": "open network uses Podman with an unrestricted policy note",
      "needs": { "os": ["linux"], "capabilities": ["network:*"] },
      "backends": { "podman": { "available": true } },
      "expected": ["podman"],
      "notePattern": "network policy is unrestricted"
    },
    {
      "name": "strict domain allowlist fails closed",
      "needs": { "os": ["linux"], "capabilities": ["pkg-install", "network:npmjs.org"] },
      "backends": { "podman": { "available": true } },
      "expected": [null],
      "result": "error",
      "reasonPattern": "cannot enforce strict domain"
    },
    {
      "name": "native operating system behavior is deferred",
      "needs": { "capabilities": ["services"], "native": true },
      "backends": {
        "lume": { "available": true },
        "ci": { "available": true, "targets": [{ "os": "macos", "arch": "arm64" }] }
      },
      "expected": [null],
      "result": "error",
      "reasonPattern": "no implemented Tier 0 or Tier 1 backend"
    }
  ]
}
