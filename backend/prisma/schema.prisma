generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// One row per Clerk-authenticated person. Subscription fields mirror Stripe
// so `isPro` can be derived without calling Stripe on every request.
model User {
  id                   String    @id @default(cuid())
  clerkId              String    @unique
  email                String    @unique

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active | trialing | past_due | canceled | incomplete | unpaid
  subscriptionPriceId  String?
  currentPeriodEnd     DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
