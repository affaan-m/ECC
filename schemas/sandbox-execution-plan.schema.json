{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecc.tools/schemas/sandbox-execution-plan.schema.json",
  "title": "ECC sandbox execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "created_at", "max_parallel", "jobs",
    "credential_requests"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "$ref": "#/definitions/id" },
    "created_at": { "$ref": "#/definitions/timestamp" },
    "max_parallel": { "type": "integer", "minimum": 1, "maximum": 32 },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/definitions/job" }
    },
    "credential_requests": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "https://ecc.tools/schemas/sandbox-credential-request.schema.json" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "domain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["in-place", "isolated-copy", "worktree"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "tier", "os", "arch"],
      "properties": {
        "backend": {
          "enum": [
            "srt", "podman", "microsandbox", "lume", "lima", "tart",
            "ci-native", "ci"
          ]
        },
        "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
        "os": { "enum": ["linux", "macos", "windows"] },
        "arch": { "enum": ["arm64", "x86_64"] }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id", "depends_on", "manifest", "trust", "network_audience",
        "workspace", "route", "credential_request_ids"
      ],
      "properties": {
        "job_id": { "$ref": "#/definitions/id" },
        "depends_on": {
          "type": "array",
          "maxItems": 127,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "manifest": { "$ref": "#/definitions/relativePath" },
        "trust": { "enum": ["first-party", "untrusted"] },
        "network_audience": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/domain" }
        },
        "workspace": { "$ref": "#/definitions/workspace" },
        "route": { "$ref": "#/definitions/route" },
        "credential_request_ids": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        }
      }
    }
  }
}
