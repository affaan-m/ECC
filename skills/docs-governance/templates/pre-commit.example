#!/bin/sh
# docs-governance optional pre-commit guard
# One invariant only: a commit with staged code changes must also stage the mapped history artifact with at least one new event.
# MAP/STATUS synchronization remains the responsibility of /governance-sync and /governance-audit.
# Test-, documentation-, artifact-, and governance-only changes are exempt.
# Install with: cp pre-commit.example .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -eu

ROOT=$(git rev-parse --show-toplevel)
MAP="$ROOT/.governance/docs-map.json"
LOG_PATH="PROJECT_LOG.md"

if [ -f "$MAP" ]; then
  if ! MAPPED=$(python3 -c 'import json,pathlib,sys; root=pathlib.Path(sys.argv[2]).resolve(); value=json.load(open(sys.argv[1], encoding="utf-8")).get("history", "PROJECT_LOG.md"); assert isinstance(value, str) and value.strip(), "history must be a non-empty path"; path=pathlib.Path(value); assert not path.is_absolute(), "history must be relative"; resolved=(root/path).resolve(); assert resolved == root or root in resolved.parents, "history escapes project root"; print(path.as_posix())' "$MAP" "$ROOT")
  then
    echo "docs-governance: invalid .governance/docs-map.json; refusing to bypass history enforcement" >&2
    exit 1
  fi
  [ -n "$MAPPED" ] && LOG_PATH="$MAPPED"
fi

# Projects without a history role do not enable this guard.
[ -f "$ROOT/$LOG_PATH" ] || exit 0

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 0

# A staged history update satisfies the invariant only when it adds an event.
if printf '%s\n' "$STAGED" | grep -Fxq "$LOG_PATH"; then
  PREVIOUS_COUNT=$(git show "HEAD:./$LOG_PATH" 2>/dev/null | grep -Ec '^## \[[0-9]{4}-[0-9]{2}-[0-9]{2}\] ' || true)
  STAGED_COUNT=$(git show ":./$LOG_PATH" 2>/dev/null | grep -Ec '^## \[[0-9]{4}-[0-9]{2}-[0-9]{2}\] ' || true)
  if [ "$STAGED_COUNT" -gt "$PREVIOUS_COUNT" ]; then
    exit 0
  fi
  echo "docs-governance: $LOG_PATH is staged but contains no new history event" >&2
  exit 1
fi

# Treat everything outside these documentation/test/governance surfaces as code.
CODE=$(printf '%s\n' "$STAGED" | grep -Ev '(^|/)(tests?|docs?|artifacts?|governance)(/|$)|(^|/)(CLAUDE|AGENTS|PROJECT_LOG|PROJECT_STATUS|CLAUDE_MAP|CONTEXT|CONTRACT|TESTS|REGRESSION)\.md$|\.(md|mdx|txt|rst)$' || true)
[ -n "$CODE" ] || exit 0

echo "docs-governance: this commit stages code but not the history artifact: $LOG_PATH" >&2
echo "Staged code paths:" >&2
printf '  %s\n' "$CODE" >&2
echo "Append one concise event, stage the history artifact, and commit again, for example:" >&2
echo "  echo '## [$(date +%Y-%m-%d)] fix | describe the change in one sentence' >> \"$LOG_PATH\" && git add \"$LOG_PATH\"" >&2
echo "Emergency bypass: git commit --no-verify. A later /governance-audit must reconcile the missing event." >&2
exit 1
