    "src/reports/writer.py": "def write_report(rows):\n    # one row per line\n    return '\\n'.join(rows)\n",
    "src/reports/format_rows.py": "def format_rows(rows):\n    return [str(r) for r in rows]\n",
    "src/cache/keys.py": "def cache_key(user):\n    return f'user:{user}'\n"
  },
