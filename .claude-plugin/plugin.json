  "userConfig": {
    "hooks_enabled": {
      "type": "boolean",
      "title": "Enable ECC hooks",
      "description": "Run ECC's local lifecycle, quality, and safety automation. Disable this to keep skills and commands without local hook automation.",
      "default": true
    },
    "hook_profile": {
      "type": "string",
      "title": "ECC hook profile",
      "description": "Choose minimal, standard, or strict. Invalid values safely fall back to standard.",
      "default": "standard"
    },
    "skill_profile": {
      "type": "string",
      "title": "ECC skill profile",
      "description": "Choose minimal, standard, or full. Standard keeps the Claude skill listing inside the listing budget. After changing this, run: node scripts/apply-skill-profile.js. Invalid values are rejected.",
      "default": "standard"
    }
  },
