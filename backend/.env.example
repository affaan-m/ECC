# Postgres connection string. In production this comes from Render/Railway's
# managed Postgres add-on. For local dev, see backend/README.md.
DATABASE_URL="postgresql://user:password@localhost:5432/stewardly_dev?schema=public"

# Clerk Dashboard -> your app -> API Keys
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Stripe Dashboard -> Developers -> API keys (use test-mode keys until launch)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for the Pro subscription (Stripe Dashboard -> Product catalog).
# STRIPE_PRICE_ID is a fallback used for whichever plan doesn't have its own
# price set — fine if you only offer one billing interval to start.
STRIPE_PRICE_ID="price_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_ANNUAL="price_..."

# The deployed frontend's origin (CORS + redirect URLs). Use your Vite dev
# server URL (e.g. http://localhost:5173) while developing locally.
FRONTEND_URL="http://localhost:5173"

PORT=4000
