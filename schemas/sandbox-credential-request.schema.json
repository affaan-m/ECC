{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecc.tools/schemas/sandbox-credential-request.schema.json",
  "title": "ECC sandbox credential request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "job_id", "credential_ref", "audience",
    "authorized_audience", "scopes", "ttl_seconds", "requested_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "credential_ref": { "type": "string", "pattern": "^env:" }
        },
        "required": ["credential_ref"]
      },
      "then": {
        "required": ["test_only"],
        "properties": {
          "test_only": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "credential_ref": {
            "type": "string",
            "pattern": "^(?:broker|vault|secret-manager)://"
          }
        },
        "required": ["credential_ref"]
      },
      "then": {
        "properties": {
          "test_only": { "const": false }
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "$ref": "#/definitions/id" },
    "job_id": { "$ref": "#/definitions/id" },
    "credential_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:env:[A-Z_][A-Z0-9_]*|(?:broker|vault|secret-manager)://[A-Za-z0-9][A-Za-z0-9._/-]*)$"
    },
    "test_only": { "type": "boolean" },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/domain" }
    },
    "authorized_audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/domainPattern" }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
      }
    },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "requested_at": { "$ref": "#/definitions/timestamp" }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "domain": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "domainPattern": {
      "type": "string",
      "minLength": 4,
      "maxLength": 255,
      "pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    }
  }
}
