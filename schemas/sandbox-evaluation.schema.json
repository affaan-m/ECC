{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecc.tools/schemas/sandbox-evaluation.schema.json",
  "title": "ECC sandbox independent evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evaluation_id", "artifact_id", "artifact_digest",
    "evaluators", "verdict", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evaluation_id": { "$ref": "#/definitions/id" },
    "artifact_id": { "$ref": "#/definitions/id" },
    "artifact_digest": { "$ref": "#/definitions/sha256" },
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required", "verdict", "findings", "artifacts"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "version": { "type": "string", "minLength": 1, "maxLength": 120 },
          "required": { "type": "boolean" },
          "verdict": { "enum": ["pass", "reject", "inconclusive"] },
          "findings": { "$ref": "#/definitions/stringArray" },
          "artifacts": {
            "type": "array", "maxItems": 1000, "uniqueItems": true,
            "items": { "$ref": "#/definitions/sha256" }
          }
        }
      }
    },
    "verdict": { "enum": ["accepted", "rejected", "inconclusive"] },
    "created_at": { "$ref": "#/definitions/timestamp" }
  },
  "definitions": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "stringArray": {
      "type": "array", "maxItems": 1000,
      "items": { "type": "string", "maxLength": 4096 }
    }
  }
}
