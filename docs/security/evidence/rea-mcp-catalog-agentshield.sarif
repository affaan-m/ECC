{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AgentShield",
          "informationUri": "https://github.com/affaan-m/agentshield",
          "rules": [
            {
              "id": "mcp-risky-filesystem",
              "name": "Template defines risky MCP server: filesystem",
              "shortDescription": {
                "text": "Template defines risky MCP server: filesystem"
              },
              "fullDescription": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. Filesystem MCP grants read/write access to the file system. Restrict to specific directories using allowedDirectories config."
              },
              "help": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. Filesystem MCP grants read/write access to the file system. Restrict to specific directories using allowedDirectories config."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "mcp",
                "severity": "medium",
                "security-severity": "5.0",
                "tags": [
                  "security",
                  "agent-config",
                  "mcp"
                ],
                "precision": "medium"
              }
            },
            {
              "id": "mcp-risky-playwright",
              "name": "Template defines risky MCP server: playwright",
              "shortDescription": {
                "text": "Template defines risky MCP server: playwright"
              },
              "fullDescription": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. Browser automation MCP can navigate to arbitrary URLs and run JavaScript. Restrict to specific domains and disable script running where possible."
              },
