            {
              "id": "mcp-npx-y-github",
              "name": "Template MCP server \"github\" uses npx -y (auto-install)",
              "shortDescription": {
                "text": "Template MCP server \"github\" uses npx -y (auto-install)"
              },
              "fullDescription": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. The MCP server \"github\" uses \"npx -y\" which automatically installs packages without confirmation. A typosquatting or supply chain attack could run malicious code."
              },
              "help": {
                "text": "This finding comes from an MCP template or example inventory, not a confirmed active runtime MCP configuration. The MCP server \"github\" uses \"npx -y\" which automatically installs packages without confirmation. A typosquatting or supply chain attack could run malicious code.\n\nRecommended fix: Remove -y flag so npx prompts before installing, or install the package explicitly"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "mcp",
                "severity": "low",
                "security-severity": "2.5",
                "tags": [
                  "security",
                  "agent-config",
                  "mcp"
                ],
                "precision": "medium"
              }
            },
